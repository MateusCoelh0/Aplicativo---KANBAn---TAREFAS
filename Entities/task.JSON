{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da tarefa"
    },
    "notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es adicionais sobre a tarefa"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ],
      "default": "todo",
      "description": "Status da tarefa no Kanban"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Prioridade da tarefa"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem da tarefa na coluna"
    }
  },
  "required": [
    "title"
  ]
}