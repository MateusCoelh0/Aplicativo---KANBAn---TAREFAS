# MongoDB
MONGDB_URI=mongodb://localhost:27017/flowduo
# Para produção, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flowduo

# Google OAuth
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=https://seu-dominio.com/api/auth/google/callback

# JWT
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_min_32_caracteres

# Environment
NODE_ENV=production
PORT=5000

# Frontend URL
FRONTEND_URL=https://seu-dominio.com

# Email Configuration
# Produção - Escolha uma opção:

# Opção 1: SendGrid (100 emails/dia grátis)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=sua_api_key_do_sendgrid
# EMAIL_FROM=noreply@seu-dominio.com

# Opção 2: Gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu-email@gmail.com
# EMAIL_PASSWORD=sua_senha_de_aplicativo
# EMAIL_FROM=seu-email@gmail.com

# Opção 3: Mailtrap (apenas para desenvolvimento/testes)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=seu_user_mailtrap
EMAIL_PASSWORD=sua_senha_mailtrap
EMAIL_FROM=noreply@flowduo.com
